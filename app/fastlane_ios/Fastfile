default_platform(:ios)

BUNDLE_ID = "sa.almubarky.fenaa"
TEAM_ID   = "5V6TC85KRL"

platform :ios do

  desc "بناء فناء ورفعه إلى TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY"],
      in_house: false
    )

    # نفس شهادة التوزيع المستخدمة في share — ملف تزويد جديد لهذا التطبيق فقط
    match(type: "appstore", api_key: api_key, readonly: false)

    profile_name = ENV["sigh_#{BUNDLE_ID}_appstore_profile-name"]

    update_code_signing_settings(
      path: "Runner.xcodeproj",
      use_automatic_signing: false,
      team_id: TEAM_ID,
      targets: ["Runner"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: BUNDLE_ID,
      profile_name: profile_name
    )

    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: ENV["BUILD_NUMBER"] || "1"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: { provisioningProfiles: { BUNDLE_ID => profile_name } }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "نسخة اختبارية من فناء"
    )
  end
end
